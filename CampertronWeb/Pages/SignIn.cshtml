@page "/signin"
@model SignInModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["HasErrors"] = Model.Error != null;
}
<h1>Sign in to Campertron</h1>
@if (Model.Error != null)
{
<div class="message error" role="alert" aria-labelledby="error-title" tabindex="-1" autofocus="autofocus">
<h2 id="error-title">There is a problem</h2>
<p><a href="#password">@Model.Error</a></p>
</div>
}
@if (Model.Notice != null)
{
<div class="message notice" role="status">
<p>@Model.Notice</p>
</div>
}
<form method="post" action="@Model.FormAction" novalidate="novalidate">
@Html.AntiForgeryToken()
<div class="field">
<label for="password">Password</label>
@if (Model.Error != null)
{
<p class="field-error" id="password-error"><span class="visually-hidden">Error: </span>@Model.Error</p>
<input type="password" id="password" name="Password" autocomplete="current-password" required="required" maxlength="128" aria-invalid="true" aria-describedby="password-error" />
}
else
{
<input type="password" id="password" name="Password" autocomplete="current-password" required="required" maxlength="128" autofocus="autofocus" />
}
</div>
<button type="submit">Sign in</button>
</form>
<p class="hint">Forgot the password? Stop Campertron's web UI, delete the file Web.password in Campertron's settings folder and start the web UI again: it then shows a one-time setup code in its console output to set a new password.</p>
