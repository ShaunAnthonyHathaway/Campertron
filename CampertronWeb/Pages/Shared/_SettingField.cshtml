@model CampertronWeb.SettingFieldView
@using CampertronLibrary.function.Forms
@{
    //one field of a shared form (the settings pages, D94; the searches pages, D96): its label, whether it is changed, the
    //form's message with its severity in words, its box, check box, choices or rows, why it is locked and its hint. Every
    //word is the form's. Written as the settings page wrote each field (v0.3.0's PR 5)
    SettingsFileViewModel F = Model.Form;
    SettingField Field = Model.Field;
    string? Focus = Model.Focus;
    string? Auto(string Id) => WebPageText.Auto(Focus, Id);
    string? Off(bool Available) => WebPageText.Off(Available);
    string Css(string? Severity) => WebPageText.Css(Severity);
    string? Described(params string?[] Ids) => WebPageText.Described(Ids);
    EmailSettingsViewModel? Email = F as EmailSettingsViewModel;
    NtfySettingsViewModel? Ntfy = F as NtfySettingsViewModel;
    GeneralSettingsViewModel? General = F as GeneralSettingsViewModel;
    string Id = WebSettingsForm.Id(Field);
    string? Message = Field.HasMessage ? Id + "-msg" : null;
    string? Lock = Field.HasLockReason ? Id + "-lock" : null;
    string Hint = Id + "-hint";
    switch (Field)
    {
        case TextSettingField Secret when Secret.IsSecret && Email != null:
<div class="field">
<div class="field-head"><label for="@Id">@Field.AccessibleName</label>@if (Field.IsChanged) {<span class="changed">Changed</span>}</div>
<p class="hint" id="@Id-state">@Email.PasswordState</p>
@if (Field.HasMessage) {<p class="field-message @Css(Field.Severity)" id="@Message">@Field.MessageText</p>}
<input type="password" id="@Id" name="@(WebSettingsForm.SecretPrefix + Field.Key)" autocomplete="new-password" spellcheck="false" disabled="@Off(Field.IsEditable)" aria-invalid="@(Field.IsError ? "true" : null)" aria-describedby="@Described(Id + "-state", Message, Lock, Id + "-replace", Hint)" autofocus="@Auto(Id)" />
<p class="hint" id="@Id-replace">To replace it, enter the new password; an empty box keeps the password as it is. This page never shows it.</p>
@if (Field.HasLockReason) {<p class="hint" id="@Lock">@Field.LockReason</p>}
<p class="hint" id="@Hint">@Field.Hint</p>
@if (Email.CanRemovePassword) {<button type="submit" name="action" value="remove-password" class="secondary">Remove the plain-text password</button>}
</div>
            break;
        case TextSettingField Text:
<div class="field">
<div class="field-head"><label for="@Id">@Field.AccessibleName</label>@if (Field.IsChanged) {<span class="changed">Changed</span>}</div>
@if (Field.HasMessage) {<p class="field-message @Css(Field.Severity)" id="@Message">@Field.MessageText</p>}
<input type="text" id="@Id" name="@(WebSettingsForm.FieldPrefix + Field.Key)" value="@Text.Text" autocomplete="off" spellcheck="false" disabled="@Off(Field.IsEditable)" aria-invalid="@(Field.IsError ? "true" : null)" aria-describedby="@Described(Message, Lock, Ntfy != null && Field.Key == "topic" ? "topic-generate-hint" : null, Hint)" autofocus="@Auto(Id)" />
@if (Field.HasLockReason) {<p class="hint" id="@Lock">@Field.LockReason</p>}
<p class="hint" id="@Hint">@Field.Hint</p>
@if (Ntfy != null && Field.Key == "topic")
{
<button type="submit" name="action" value="generate-topic" class="secondary" disabled="@Off(Ntfy.CanGenerateTopic)" aria-describedby="topic-generate-hint">@Ntfy.GenerateTopicLabel</button>
<p class="hint" id="topic-generate-hint">@Ntfy.GenerateTopicHelp</p>
}
@if (Email != null && Field.Key == "smtpPasswordFile" && Email.CanRemovePasswordFile)
{
<button type="submit" name="action" value="remove-password-file" class="secondary">Remove smtpPasswordFile</button>
}
@if (Ntfy != null && Field.Key == "tokenFile")
{
@if (Ntfy.CanRemoveTokenFile) {<button type="submit" name="action" value="remove-token-file" class="secondary">Remove tokenFile</button>}
}
</div>
            break;
        case BoolSettingField Switch:
<div class="field check">
<input type="hidden" name="@(WebSettingsForm.PresentPrefix + Field.Key)" value="1" />
<input type="checkbox" id="@Id" name="@(WebSettingsForm.FieldPrefix + Field.Key)" value="true" checked="@(Switch.IsChecked ? "checked" : null)" disabled="@Off(Field.IsEditable)" aria-invalid="@(Field.IsError ? "true" : null)" aria-describedby="@Described(Message, Lock, Hint)" autofocus="@Auto(Id)" />
<label for="@Id">@Field.AccessibleName</label>@if (Field.IsChanged) {<span class="changed">Changed</span>}
@if (Field.HasMessage) {<p class="field-message @Css(Field.Severity)" id="@Message">@Field.MessageText</p>}
@if (Field.HasLockReason) {<p class="hint" id="@Lock">@Field.LockReason</p>}
<p class="hint" id="@Hint">@Field.Hint</p>
@if (General != null && Field.Key == "autoRefresh") {<p class="hint">@General.RefreshExplanation</p>}
</div>
            break;
        case ChoiceSettingField Choice:
<fieldset class="field" id="@Id" aria-describedby="@Described(Message, Lock, Hint)">
<legend>@Field.AccessibleName@if (Field.IsChanged) {<span class="changed">Changed</span>}</legend>
@if (Field.HasMessage) {<p class="field-message @Css(Field.Severity)" id="@Message">@Field.MessageText</p>}
@for (int i = 0; i < Choice.Choices.Count; i++)
{
<div class="choice"><input type="radio" id="@(Id + "-" + i)" name="@(WebSettingsForm.FieldPrefix + Field.Key)" value="@i" checked="@(ReferenceEquals(Choice.Choices[i], Choice.Selected) ? "checked" : null)" disabled="@Off(Field.IsEditable)" /><label for="@(Id + "-" + i)">@Choice.Choices[i].Label</label></div>
}
@if (Field.HasLockReason) {<p class="hint" id="@Lock">@Field.LockReason</p>}
<p class="hint" id="@Hint">@Field.Hint</p>
</fieldset>
            if (General != null && Field.Key == "outputTo")
            {
<p class="message @Css(General.NtfyStatusSeverity)" id="ntfy-line">@MessageSeverity.AccessibleText(General.NtfyStatus, General.NtfyStatusSeverity)</p>
            }
            break;
        case ListSettingField List:
<fieldset class="field list" id="@Id" aria-describedby="@Described(Id + "-rows", Message, Lock, Hint)">
<legend>@Field.AccessibleName@if (Field.IsChanged) {<span class="changed">Changed</span>}</legend>
<p class="hint" id="@Id-rows">@List.RowsHelp</p>
<input type="hidden" name="@(WebSettingsForm.RowsPrefix + Field.Key)" value="@List.Rows.Count" />
@if (List.HasNoRows)
{
<p class="hint">@List.EmptyText</p>
}
else
{
<ol class="rows">
@for (int i = 0; i < List.Rows.Count; i++)
{
    ListRow Row = List.Rows[i];
    string RowId = WebSettingsForm.RowId(List, i);
    string? RowMessage = Row.HasMessage ? RowId + "-msg" : null;
<li class="row">
<label for="@RowId">@Row.AccessibleName</label>
<div class="row-controls">
<input type="text" id="@RowId" name="@(WebSettingsForm.FieldPrefix + Field.Key + "." + i)" value="@Row.Text" placeholder="@Row.Placeholder" autocomplete="off" spellcheck="false" disabled="@Off(Field.IsEditable)" aria-invalid="@(Row.IsError ? "true" : null)" aria-describedby="@RowMessage" autofocus="@Auto(RowId)" />
<button type="submit" name="action" value="@("row-up." + Field.Key + "." + i)" class="secondary" aria-label="@Row.UpName" disabled="@Off(Row.UpCommand?.CanExecute(null) == true)">Up</button>
<button type="submit" name="action" value="@("row-down." + Field.Key + "." + i)" class="secondary" aria-label="@Row.DownName" disabled="@Off(Row.DownCommand?.CanExecute(null) == true)">Down</button>
<button type="submit" name="action" value="@("row-remove." + Field.Key + "." + i)" class="secondary" aria-label="@Row.RemoveName" disabled="@Off(Row.RemoveCommand?.CanExecute(null) == true)">Remove</button>
</div>
@if (Row.HasMessage) {<p class="field-message @Css(Row.Severity)" id="@RowMessage">@Row.MessageText</p>}
</li>
}
</ol>
}
<button type="submit" name="action" value="@("row-add." + Field.Key)" id="@WebSettingsForm.AddId(Field)" class="secondary" disabled="@Off(List.AddCommand.CanExecute(null))" aria-describedby="@Id-rows" autofocus="@Auto(WebSettingsForm.AddId(Field))">@List.AddLabel</button>
@if (Field.HasMessage) {<p class="field-message @Css(Field.Severity)" id="@Message">@Field.MessageText</p>}
@if (Field.HasLockReason) {<p class="hint" id="@Lock">@Field.LockReason</p>}
<p class="hint" id="@Hint">@Field.Hint</p>
</fieldset>
            break;
    }
}
