@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Start";
}
<h1>Campertron</h1>
<p>@(Model.SignedIn ? "You are signed in to Campertron's web UI." : "This is Campertron's web UI. It is used without a password.")</p>
<p>The <a href="/searches">search files</a> and the <a href="/settings/general">settings</a> of General.yaml, Email.yaml, Ntfy.yaml and Web.yaml can be edited here, with a test email and a test notification, the search files can be run on request, with their <a href="/results">results</a>, the <a href="/monitoring">monitoring</a> that notifies new openings by email or ntfy can be started and stopped, the <a href="/campgrounds/park">campgrounds</a> can be looked up, and the <a href="/settings/system">system</a> page shows the current configuration and refreshes the campground data.</p>
<section class="guided" aria-labelledby="guided-heading">
<h2 id="guided-heading">@CampertronLibrary.function.Forms.GuidedSetupWording.Heading</h2>
<p>@Model.GuidedText</p>
<p><a href="@Model.GuidedAddress">@Model.GuidedLink</a></p>
</section>
<dl class="facts">
<dt>Version</dt>
<dd>@Model.Version</dd>
<dt>Password</dt>
<dd>@(Model.PasswordProtection ? "Required to use this web UI" : "Not required: everyone who can reach this web UI can use it")</dd>
</dl>
