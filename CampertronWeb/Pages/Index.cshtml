@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Start";
}
<h1>Campertron</h1>
<p>@(Model.SignedIn ? "You are signed in to Campertron's web UI." : "This is Campertron's web UI. It is used without a password.")</p>
<p>The <a href="/settings/general">settings</a> of General.yaml, Email.yaml, Ntfy.yaml and Web.yaml can be edited here, with a test email and a test notification. This version of the web UI has no pages yet for the searches, the results, the monitoring and the campground data: until it does, use CampertronGUI or edit the search files.</p>
<dl class="facts">
<dt>Version</dt>
<dd>@Model.Version</dd>
<dt>Password</dt>
<dd>@(Model.PasswordProtection ? "Required to use this web UI" : "Not required: everyone who can reach this web UI can use it")</dd>
</dl>
