@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Start";
}
<h1>Campertron</h1>
<p>@(Model.SignedIn ? "You are signed in to Campertron's web UI." : "This is Campertron's web UI. It is used without a password.")</p>
<p>This version of the web UI has no pages yet for the settings, the searches, the results, the monitoring and the campground data. Until it does, set Campertron up with CampertronGUI or by editing its settings files.</p>
<dl class="facts">
<dt>Version</dt>
<dd>@Model.Version</dd>
<dt>Password</dt>
<dd>@(Model.PasswordProtection ? "Required to use this web UI" : "Not required: everyone who can reach this web UI can use it")</dd>
</dl>
