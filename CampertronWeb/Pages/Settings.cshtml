@page "/settings/{file?}"
@model SettingsModel
@using CampertronLibrary.function.Forms
@{
    //the settings pages (v0.3.0's PR 5): every label, hint, message, state and result is the shared form's (D91); the
    //page arranges them. One form per file posts the user's entries with each button; Check changes is the button Enter
    //presses. Nothing here holds a password or a token: the SMTP password's box is always empty (D82)
    SettingsFileViewModel F = Model.Form;
    List<(string Id, string Text)> Errors = Model.Errors();
    ViewData["Title"] = "Settings: " + F.FileName;
    ViewData["HasErrors"] = Errors.Count > 0;
    string? Focus = Model.FocusId;
}
<h1>Settings</h1>
<p>Campertron's settings files, with the rules and words of CampertronGUI's Settings &gt; Campertron. Nothing is written until you save a file.</p>
@await Html.PartialAsync("_SettingsNav", Model.Shown)
<h2>@F.Title (@F.FileName)</h2>
@await Html.PartialAsync("_SettingsFileForm", new SettingsFormView(F, "/settings/" + Model.Shown, "/settings/" + Model.Shown + "?handler=test", Model.Revision, Focus, Model.Posted,
    Model.PageNotice, Errors, Model.EmailPasswordVariableSet, Model.NtfyTokenVariableSet, Model.WithoutFolder))
