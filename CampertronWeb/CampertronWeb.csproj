<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The web UI (decisions D80 and D92): Razor Pages in a class library that CampertronConsole hosts (CampertronConsole web mode).
       No package: only the ASP.NET Core shared framework, a framework reference. Its stylesheet, its icon and the results
       page's script are embedded resources the host serves from memory, so no file of a folder is ever served (no wwwroot,
       no static web assets). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\site.css" LogicalName="CampertronWeb.Assets.site.css" />
    <!-- the results page's script (D108): its automatic progress while a search runs; no library -->
    <EmbeddedResource Include="Assets\results.js" LogicalName="CampertronWeb.Assets.results.js" />
    <!-- the unified app icon (D89), the browser's favicon; generated by assets/icon/generate-icon.py -->
    <EmbeddedResource Include="..\assets\icon\campertron.ico" LogicalName="CampertronWeb.Assets.campertron.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampertronLibrary\CampertronLibrary.csproj" />
  </ItemGroup>

</Project>
