<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Campertron.ViewModels"
             xmlns:views="using:Campertron.Views"
             xmlns:forms="clr-namespace:CampertronLibrary.function.Forms;assembly=CampertronLibrary"
             x:CompileBindings="True"
             x:DataType="vm:CampgroundDataViewModel"
             x:Class="Campertron.Views.CampgroundDataView">
	<!--
	  Settings > System > Campground data (V011-1, decision D61): when the campground data was last refreshed and the console's
	  "Refresh Ridb Data" as an action. Refresh campground data… shows a confirmation in this card (Start refresh, Back;
	  Escape is Back) and starts nothing; while the refresh runs, the stage, a named progress bar, the counts with the elapsed
	  time and Cancel, which is enabled only while the refresh can still stop. The status line is a polite live region: each
	  stage and the result, in words (an error is also colored, never only colored). Focus: the confirmation's Start refresh
	  when it opens, Refresh campground data… again when it closes or the refresh ends, Cancel while it runs.
	-->
	<Border Name="CampgroundDataCard" Classes="card">
		<StackPanel Spacing="12">
			<StackPanel Spacing="4">
				<TextBlock Name="CampgroundDataHeading" Classes="sectionHeading" Text="{x:Static forms:RefreshWording.Heading}" Margin="0" AutomationProperties.HeadingLevel="2" />
				<TextBlock Name="CampgroundDataExplanation" Classes="secondary body" Text="{x:Static vm:CampgroundDataViewModel.Explanation}" />
			</StackPanel>
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
				<TextBlock Name="LastRefreshedLabel" Classes="fieldLabel" Text="{x:Static forms:RefreshWording.LastRefreshedLabel}" />
				<SelectableTextBlock Name="LastRefreshedValue" Grid.Column="1" Classes="body" TextWrapping="Wrap" IsTabStop="False"
				                     Text="{Binding LastRefreshedText}" AutomationProperties.HelpText="{x:Static forms:RefreshWording.LastRefreshedLabel}" />
			</Grid>
			<StackPanel Name="RefreshActions" Spacing="4" IsVisible="{Binding ShowsRefreshButton}">
				<Button Name="RefreshDatabaseButton" Content="{x:Static forms:RefreshWording.RefreshLabel}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"
				        ToolTip.Tip="{x:Static forms:RefreshWording.RefreshTip}"
				        AutomationProperties.Name="{x:Static forms:RefreshWording.RefreshName}"
				        AutomationProperties.HelpText="{x:Static forms:RefreshWording.RefreshHelp}" />
			</StackPanel>
			<TextBlock Name="RefreshUnavailableText" Classes="body" Text="{Binding UnavailableReason}" IsVisible="{Binding HasUnavailableReason}" />
			<Border Name="RefreshConfirmation" Classes="card notice" IsVisible="{Binding IsConfirming}">
				<StackPanel Spacing="8">
					<TextBlock Name="RefreshConfirmationHeading" Classes="sectionHeading" Margin="0" Text="{x:Static forms:RefreshWording.ConfirmationHeading}"
					           AutomationProperties.HeadingLevel="3" />
					<TextBlock Name="RefreshConfirmationText" Classes="body" Text="{x:Static vm:CampgroundDataViewModel.ConfirmationText}" />
					<WrapPanel Orientation="Horizontal">
						<Button Name="StartRefreshButton" Classes="accent" Content="{x:Static forms:RefreshWording.StartLabel}" Margin="0,0,8,4" Command="{Binding StartCommand}"
						        AutomationProperties.HelpText="{x:Static forms:RefreshWording.StartHelp}" />
						<Button Name="RefreshBackButton" Content="{x:Static forms:RefreshWording.BackLabel}" Margin="0,0,8,4" Command="{Binding BackCommand}"
						        AutomationProperties.Name="{x:Static forms:RefreshWording.BackName}"
						        AutomationProperties.HelpText="Close this without refreshing (Escape)" />
					</WrapPanel>
				</StackPanel>
			</Border>
			<StackPanel Name="RefreshProgressPanel" Spacing="6" IsVisible="{Binding IsRunning}">
				<ProgressBar Name="RefreshProgressBar" IsIndeterminate="{Binding ProgressIsIndeterminate}" Minimum="0" Maximum="{Binding ProgressMaximum}"
				             Value="{Binding ProgressValue}" ShowProgressText="False" AutomationProperties.Name="{x:Static forms:RefreshWording.ProgressName}" />
				<TextBlock Name="RefreshProgressDetails" Classes="secondary body" Text="{Binding ProgressDetails}" IsVisible="{Binding ShowsProgressDetails}" />
				<Button Name="CancelRefreshButton" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" HorizontalAlignment="Left"
				        ToolTip.Tip="{x:Static forms:RefreshWording.CancelTip}"
				        AutomationProperties.Name="{x:Static forms:RefreshWording.CancelName}"
				        AutomationProperties.HelpText="{x:Static forms:RefreshWording.CancelHelp}" />
			</StackPanel>
			<views:SeverityBlock IsError="{Binding ResultIsError}">
				<TextBlock Name="RefreshStatusText" Classes="body" FontWeight="SemiBold" Text="{Binding StatusText}"
				           IsVisible="{Binding HasStatus}" AutomationProperties.LiveSetting="Polite" />
			</views:SeverityBlock>
		</StackPanel>
	</Border>
</UserControl>
