<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Campertron.ViewModels"
             xmlns:forms="clr-namespace:CampertronLibrary.function.Forms;assembly=CampertronLibrary"
             xmlns:views="using:Campertron.Views"
             x:CompileBindings="True"
             x:DataType="forms:SettingsFileViewModel"
             x:Class="Campertron.Views.SettingsFileStatusView">
	<!--
	  The top of a settings file editor (CM5, decision D43): why the file can't be edited (missing, unreadable, read-only)
	  with Create or Reload, a change by another program with the ways to resolve it, and the problems that are about the
	  whole file. Every text here is fixed text, key names and file names: never a value of the file. The conflict's block can
	  take the focus the guided setup gives it (v0.4.0's phase 5; never a Tab stop).
	-->
	<StackPanel Spacing="12">
		<Border Name="StateCard" Classes="card notice" IsVisible="{Binding HasStateText}">
			<StackPanel Spacing="8">
				<views:SeverityBlock Severity="Warning">
					<SelectableTextBlock Name="StateText" Classes="body" Text="{Binding StateText}" IsTabStop="False"
					                     AutomationProperties.LiveSetting="Polite" />
				</views:SeverityBlock>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Name="CreateButton" Content="{Binding CreateLabel}" Command="{Binding CreateCommand}" IsVisible="{Binding IsMissing}"
					        ToolTip.Tip="Create the file with the default settings a first start writes" />
					<Button Name="StateReloadButton" Content="Reload from disk" Command="{Binding ReloadCommand}" IsVisible="{Binding !IsMissing}"
					        ToolTip.Tip="Read the file again after correcting it in a text editor" />
				</StackPanel>
			</StackPanel>
		</Border>

		<Border Name="ConflictCard" Classes="card notice" IsVisible="{Binding HasConflict}">
			<StackPanel Spacing="8">
				<TextBlock Classes="sectionHeading" Text="Changed by another program" AutomationProperties.HeadingLevel="2" />
				<views:SeverityBlock Name="ConflictBlock" Severity="Warning" Focusable="True" IsTabStop="False">
					<SelectableTextBlock Name="ConflictText" Classes="body" Text="{Binding ConflictText}" IsTabStop="False"
					                     AutomationProperties.LiveSetting="Assertive" />
				</views:SeverityBlock>
				<WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
					<Button Name="ApplyMineButton" Content="{Binding ApplyMineLabel}" Command="{Binding ApplyMineCommand}" IsVisible="{Binding CanApplyMine}" />
					<Button Name="RecreateButton" Content="Create the file again with my changes" Command="{Binding RecreateCommand}" IsVisible="{Binding CanRecreate}" />
					<Button Name="UseTheirsButton" Content="Discard my changes and use the file on disk" Command="{Binding UseTheirsCommand}" />
				</WrapPanel>
			</StackPanel>
		</Border>

		<ItemsControl Name="FileNoticesList" ItemsSource="{Binding FileNotices}" IsVisible="{Binding HasFileNotices}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Spacing="4" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="forms:NoticeItem">
					<views:SeverityBlock IsError="{Binding IsError}">
						<TextBlock Classes="body" Text="{Binding Text}" />
					</views:SeverityBlock>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</StackPanel>
</UserControl>
