<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Campertron.ViewModels"
             xmlns:forms="clr-namespace:CampertronLibrary.function.Forms;assembly=CampertronLibrary"
             xmlns:views="using:Campertron.Views"
             x:CompileBindings="True"
             x:DataType="forms:NtfySettingsViewModel"
             x:Class="Campertron.Views.NtfySettingsView">
	<!--
	  Ntfy.yaml (decision D69). Each setting as in Email.yaml's editor: its label (with an access key), whether it is changed,
	  the control, the validation's message for it (its severity in words; also the control's accessible help text) and what
	  it does. A missing Ntfy.yaml is a new file: the form shows the defaults and nothing is written until a change is saved.
	  The topic is shown only in its own box and in the preview of a save. The access token is never read or shown: tokenFile
	  is a path. Nothing here connects to a server or publishes, but the test notification the user asks for (D86, D88), and
	  nothing changes outputTo (General.yaml's). Generate a random topic (D86) fills Topic as an unsaved change.
	-->
	<StackPanel Spacing="12">
		<StackPanel Spacing="2">
			<TextBlock Classes="title" Text="{Binding Title}" AutomationProperties.HeadingLevel="1" />
			<SelectableTextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding FilePath}" IsTabStop="False" />
			<TextBlock Name="NtfyModeText" Classes="body" Text="{Binding ModeText}" AutomationProperties.LiveSetting="Polite" />
			<TextBlock Name="NtfyModeHelp" Classes="secondary body" Text="{Binding ModeHelp}" />
			<Button Name="ShowGeneralButton" Content="Choose outputTo in General.yaml" Command="{Binding ShowGeneralCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
			        ToolTip.Tip="Show General.yaml, where outputTo is chosen (this editor never changes it)" />
		</StackPanel>
		<views:SettingsFileStatusView Name="NtfyFileStatus" />
		<Border Name="NtfyForm" Classes="card" IsVisible="{Binding !IsMissing}">
			<StackPanel Spacing="16">
				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<CheckBox Name="NtfyEnabledCheckBox" Content="{Binding Enabled.Label}" IsChecked="{Binding Enabled.IsChecked}"
						          IsEnabled="{Binding Enabled.IsEditable}" AutomationProperties.Name="{Binding Enabled.AccessibleName}"
						          AutomationProperties.HelpText="{Binding Enabled.HelpText}" />
						<TextBlock Classes="secondary" VerticalAlignment="Center" Text="Changed" IsVisible="{Binding Enabled.IsChanged}" />
					</StackPanel>
					<views:SeverityBlock IsError="{Binding Enabled.IsError}">
						<TextBlock Classes="body" Text="{Binding Enabled.MessageText}" IsVisible="{Binding Enabled.HasMessage}" />
					</views:SeverityBlock>
					<TextBlock Classes="secondary body" Text="{Binding Enabled.LockReason}" IsVisible="{Binding Enabled.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding Enabled.Hint}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Label Classes="fieldLabel" Content="{Binding Server.Label}" Target="{Binding #NtfyServerBox}" />
						<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding Server.IsChanged}" />
					</StackPanel>
					<TextBox Name="NtfyServerBox" Text="{Binding Server.Text}" IsEnabled="{Binding Server.IsEditable}" PlaceholderText="for example https://ntfy.sh"
					         AutomationProperties.Name="{Binding Server.AccessibleName}" AutomationProperties.HelpText="{Binding Server.HelpText}" />
					<views:SeverityBlock IsError="{Binding Server.IsError}">
						<TextBlock Classes="body" Text="{Binding Server.MessageText}" IsVisible="{Binding Server.HasMessage}" />
					</views:SeverityBlock>
					<TextBlock Classes="secondary body" Text="{Binding Server.LockReason}" IsVisible="{Binding Server.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding Server.Hint}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Label Classes="fieldLabel" Content="{Binding Topic.Label}" Target="{Binding #NtfyTopicBox}" />
						<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding Topic.IsChanged}" />
					</StackPanel>
					<Grid ColumnDefinitions="*,Auto">
						<TextBox Name="NtfyTopicBox" Text="{Binding Topic.Text}" IsEnabled="{Binding Topic.IsEditable}" PlaceholderText="a long, random topic"
						         AutomationProperties.Name="{Binding Topic.AccessibleName}" AutomationProperties.HelpText="{Binding Topic.HelpText}" />
						<Button Name="GenerateTopicButton" Grid.Column="1" Margin="8,0,0,0" Content="{Binding GenerateTopicLabel}" Command="{Binding GenerateTopicCommand}"
						        AutomationProperties.Name="{Binding GenerateTopicLabel}" AutomationProperties.HelpText="{Binding GenerateTopicHelp}"
						        ToolTip.Tip="{Binding GenerateTopicHelp}" />
					</Grid>
					<views:SeverityBlock IsError="{Binding Topic.IsError}">
						<TextBlock Classes="body" Text="{Binding Topic.MessageText}" IsVisible="{Binding Topic.HasMessage}" />
					</views:SeverityBlock>
					<TextBlock Classes="secondary body" Text="{Binding Topic.LockReason}" IsVisible="{Binding Topic.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding Topic.Hint}" />
					<TextBlock Name="GenerateTopicHelpText" Classes="secondary body" Text="{Binding GenerateTopicHelp}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Label Classes="fieldLabel" Content="{Binding TokenFile.Label}" Target="{Binding #NtfyTokenFileBox}" />
						<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding TokenFile.IsChanged}" />
					</StackPanel>
					<!-- no column spacing: the hidden button would still take it, so the button has its own margin -->
					<Grid ColumnDefinitions="*,Auto">
						<TextBox Name="NtfyTokenFileBox" Text="{Binding TokenFile.Text}" IsEnabled="{Binding TokenFile.IsEditable}"
						         PlaceholderText="optional: the token file's full path"
						         AutomationProperties.Name="{Binding TokenFile.AccessibleName}" AutomationProperties.HelpText="{Binding TokenFile.HelpText}" />
						<Button Name="RemoveTokenFileButton" Grid.Column="1" Margin="8,0,0,0" Content="Remove tokenFile" Command="{Binding RemoveTokenFileCommand}"
						        IsVisible="{Binding CanRemoveTokenFile}" AutomationProperties.Name="Remove tokenFile from Ntfy.yaml"
						        ToolTip.Tip="Remove tokenFile from Ntfy.yaml when you save: the monitoring then uses CAMPERTRON_NTFY_TOKEN if it is set, else no token" />
					</Grid>
					<views:SeverityBlock IsError="{Binding TokenFile.IsError}">
						<TextBlock Name="TokenFileMessage" Classes="body" Text="{Binding TokenFile.MessageText}" IsVisible="{Binding TokenFile.HasMessage}" />
					</views:SeverityBlock>
					<TextBlock Classes="secondary body" Text="{Binding TokenFile.LockReason}" IsVisible="{Binding TokenFile.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding TokenFile.Hint}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Label Classes="fieldLabel" Content="{Binding Priority.Label}" Target="{Binding #NtfyPriorityComboBox}" />
						<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding Priority.IsChanged}" />
					</StackPanel>
					<ComboBox Name="NtfyPriorityComboBox" HorizontalAlignment="Stretch" ItemsSource="{Binding Priority.Choices}" SelectedItem="{Binding Priority.Selected}"
					          IsEnabled="{Binding Priority.IsEditable}" AutomationProperties.Name="{Binding Priority.AccessibleName}"
					          AutomationProperties.HelpText="{Binding Priority.HelpText}" />
					<views:SeverityBlock IsError="{Binding Priority.IsError}">
						<TextBlock Classes="body" Text="{Binding Priority.MessageText}" IsVisible="{Binding Priority.HasMessage}" />
					</views:SeverityBlock>
					<TextBlock Classes="secondary body" Text="{Binding Priority.LockReason}" IsVisible="{Binding Priority.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding Priority.Hint}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Label Classes="fieldLabel" Content="{Binding Tags.Label}" Target="{Binding #AddTagButton}" />
						<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding Tags.IsChanged}" />
					</StackPanel>
					<TextBlock Name="TagsHelp" Classes="secondary body" Text="{Binding Tags.RowsHelp}" />
					<ItemsControl Name="NtfyTagsList" ItemsSource="{Binding Tags.Rows}" IsEnabled="{Binding Tags.IsEditable}"
					              AutomationProperties.Name="{Binding Tags.AccessibleName}" AutomationProperties.HelpText="{Binding Tags.HelpText}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Spacing="8" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="forms:ListRow">
								<StackPanel Spacing="2">
									<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
										<TextBox Name="TagBox" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding AccessibleName}"
										         AutomationProperties.HelpText="{Binding HelpText}" />
										<Button Name="TagUpButton" Grid.Column="1" Content="Up" Command="{Binding UpCommand}" AutomationProperties.Name="{Binding UpName}" />
										<Button Name="TagDownButton" Grid.Column="2" Content="Down" Command="{Binding DownCommand}" AutomationProperties.Name="{Binding DownName}" />
										<Button Name="TagRemoveButton" Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding RemoveName}" />
									</Grid>
									<views:SeverityBlock IsError="{Binding IsError}">
										<TextBlock Classes="body" Text="{Binding MessageText}" IsVisible="{Binding HasMessage}" />
									</views:SeverityBlock>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<TextBlock Classes="secondary body" Text="No tags in the file." IsVisible="{Binding Tags.HasNoRows}" />
					<Button Name="AddTagButton" Content="Add tag" Command="{Binding AddTagCommand}" HorizontalAlignment="Left"
					        AutomationProperties.Name="Add tag" AutomationProperties.HelpText="{Binding Tags.AddHelpText}" />
					<views:SeverityBlock IsError="{Binding Tags.IsError}">
						<TextBlock Classes="body" Text="{Binding Tags.MessageText}" IsVisible="{Binding Tags.HasMessage}" />
					</views:SeverityBlock>
					<TextBlock Classes="secondary body" Text="{Binding Tags.LockReason}" IsVisible="{Binding Tags.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding Tags.Hint}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Label Classes="fieldLabel" Content="{Binding TimeoutSeconds.Label}" Target="{Binding #NtfyTimeoutBox}" />
						<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding TimeoutSeconds.IsChanged}" />
					</StackPanel>
					<TextBox Name="NtfyTimeoutBox" Text="{Binding TimeoutSeconds.Text}" IsEnabled="{Binding TimeoutSeconds.IsEditable}"
					         AutomationProperties.Name="{Binding TimeoutSeconds.AccessibleName}" AutomationProperties.HelpText="{Binding TimeoutSeconds.HelpText}" />
					<views:SeverityBlock IsError="{Binding TimeoutSeconds.IsError}">
						<TextBlock Classes="body" Text="{Binding TimeoutSeconds.MessageText}" IsVisible="{Binding TimeoutSeconds.HasMessage}" />
					</views:SeverityBlock>
					<TextBlock Classes="secondary body" Text="{Binding TimeoutSeconds.LockReason}" IsVisible="{Binding TimeoutSeconds.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding TimeoutSeconds.Hint}" />
				</StackPanel>
			</StackPanel>
		</Border>
		<views:SettingsFileActionsView Name="NtfyActions" />
		<!-- D86, D88: one test with the saved file, on the user's action only; the send runs on a worker thread -->
		<Border Name="NtfyTestCard" Classes="card">
			<StackPanel Spacing="8">
				<TextBlock Classes="sectionHeading" Text="{Binding Test.Heading}" AutomationProperties.HeadingLevel="2" />
				<TextBlock Classes="secondary body" Text="{Binding Test.Explanation}" />
				<StackPanel Orientation="Horizontal" Spacing="12">
					<Button Name="NtfyTestButton" Content="{Binding Test.ButtonLabel}" Command="{Binding Test.SendCommand}" />
					<TextBlock Name="NtfyTestBusy" Classes="body" VerticalAlignment="Center" Text="{Binding Test.BusyText}" IsVisible="{Binding Test.IsSending}"
					           AutomationProperties.LiveSetting="Polite" />
				</StackPanel>
				<TextBlock Name="NtfyTestUnavailable" Classes="secondary body" Text="{Binding Test.UnavailableReason}" IsVisible="{Binding Test.HasUnavailableReason}" />
				<views:SeverityBlock Severity="{Binding Test.ResultSeverity}">
					<TextBlock Name="NtfyTestResult" Classes="body" Text="{Binding Test.ResultText}" IsVisible="{Binding Test.HasResult}"
					           AutomationProperties.LiveSetting="Assertive" />
				</views:SeverityBlock>
			</StackPanel>
		</Border>
	</StackPanel>
</UserControl>
