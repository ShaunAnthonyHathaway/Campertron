<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:Campertron.ViewModels"
		xmlns:views="using:Campertron.Views"
		xmlns:forms="clr-namespace:CampertronLibrary.function.Forms;assembly=CampertronLibrary"
		xmlns:lib="clr-namespace:;assembly=CampertronLibrary"
		xmlns:app="using:Campertron"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:CompileBindings="True"
		x:DataType="vm:MainWindowViewModel"
        x:Class="Campertron.Views.MainWindow"
        Title="Campertron"
        Icon="/Assets/campertron.ico"
        Width="1024" Height="768" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.Resources>
		<!-- Long park and campground names are trimmed with an ellipsis instead of widening the selector. -->
		<DataTemplate x:Key="NameItemTemplate" x:DataType="x:String">
			<TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<!-- Shows an empty city as "(No city listed)"; the item (and the query) keep the stored value. -->
		<DataTemplate x:Key="CityItemTemplate" x:DataType="x:String">
			<TextBlock Text="{Binding Converter={x:Static views:DisplayConverters.City}}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<!-- A campground (decision D42): names are not unique, so each entry shows its name and location, trimmed, and
		     its FacilityID, which always stays visible. The whole label is the tooltip; the accessible name is set on
		     the item container by the style below. -->
		<DataTemplate x:Key="CampgroundItemTemplate" x:DataType="lib:CampgroundChoice">
			<Grid Name="CampgroundItem" ColumnDefinitions="*,Auto" ColumnSpacing="12" ToolTip.Tip="{Binding Label}">
				<TextBlock Name="CampgroundItemTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
				<TextBlock Name="CampgroundItemId" Grid.Column="1" Classes="secondary" Text="{Binding IdText}" />
			</Grid>
		</DataTemplate>
	</Window.Resources>

	<Window.Styles>
		<!-- Screen readers read a campground entry as its whole label: name, location and ID. -->
		<Style Selector="ComboBox.campground ComboBoxItem" x:DataType="lib:CampgroundChoice">
			<Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
		</Style>
		<!-- The drop-down is as wide as its selector (it would otherwise grow to the longest name and push the IDs out of
		     the window): long names are trimmed there too, and every ID stays visible. -->
		<Style Selector="ComboBox.campground /template/ Popup">
			<Setter Property="MaxWidth" Value="{Binding $parent[ComboBox].Bounds.Width}" />
		</Style>
	</Window.Styles>

	<!--
	  Until the startup has prepared the configuration and the campground database, StartupStatusView shows its
	  progress or its error (R8); the tabs and their view models exist only after it succeeded.
	  Five top-level tabs, in this order (decision D50; Monitoring since v0.4.0's phase 4, D118): Searches (CM6) creates and edits
	  search files and reads the campground data once, when it is first shown (the first tab, so at the end of the startup);
	  Results (GS2) runs saved search files and shows their results, sharing the Searches tab's campground data; Monitoring
	  shows the application's monitoring (its Start, Stop and Restart; the monitoring is the application's, never the tab's,
	  D115), as the web UI's monitoring page is between Results and Settings; Settings holds two tabs of its own,
	  Campertron (CM5: General.yaml and Email.yaml, edited safely; no database) and System (the GUI's theme, a preference of
	  this application stored apart from every YAML file); Campgrounds holds the three lookup tabs By Park, By City and By
	  State (beta.8, D42; labeled Campsites until D55, which kept its automation IDs CampsitesTab and CampsitesTabControl). Each lookup tab has its own filters, campground selection and details: a filter card on top, then
	  the shared CampgroundDetailsView. Every list and details property queries the database when read, so each is bound
	  exactly once.
	  The responsive layout (decision D106): each tab's ResponsiveColumns shows one centered column below the wide width and
	  two columns from it up. The tabs span the window, with the same margins on every tab (decision D107: D106's cap of the
	  tabs at 1416 left large margins around Results); how far each page grows is its own width category (AppStyles.axaml).
	  The Campgrounds filter card spans its lookup's columns up to the readable 400 + 16 + 960, at their left.
	-->
	<Panel>
	<views:StartupStatusView Name="StartupStatus" IsVisible="{Binding !IsReady}" />
	<TabControl Name="MainTabControl" Margin="8,4,8,0" IsVisible="{Binding IsReady}" IsEnabled="{Binding !IsConfirmingClose}">
		<!-- CM6 (decision D44): search files, created and edited safely; no searching, no availability. -->
		<TabItem Name="SearchesTab" Header="Searches">
			<views:SearchesView Name="SearchesContent" DataContext="{Binding Searches}" />
		</TabItem>
		<!-- GS2 (decision D46): run saved search files and show their typed results (GS1's CampsiteSearch). -->
		<TabItem Name="ResultsTab" Header="Results">
			<views:ResultsView Name="ResultsContent" DataContext="{Binding Results}" />
		</TabItem>
		<!-- v0.4.0's phase 4 (D115, D118): the application's monitoring through the shared MonitoringController. -->
		<TabItem Name="MonitoringTab" Header="{x:Static forms:MonitoringWording.Heading}">
			<views:MonitoringView Name="MonitoringContent" DataContext="{Binding MonitoringTab}" />
		</TabItem>
		<TabItem Name="SettingsTab" Header="Settings">
			<TabControl Name="SettingsTabControl" Classes="nested">
				<!-- CM5 (decision D43): General.yaml and Email.yaml, edited safely; not search files, no searching. -->
				<TabItem Name="CampertronSettingsTab" Header="Campertron">
					<views:SettingsView Name="SettingsContent" DataContext="{Binding Settings}" />
				</TabItem>
				<!-- D50: the GUI's theme (System, Light or Dark), saved as a preference of this application, not in YAML; since
				     V011-2 (D60) also the current configuration (the console's View Config items), read-only. -->
				<TabItem Name="SystemSettingsTab" Header="System">
					<views:SystemSettingsView Name="SystemSettingsContent" DataContext="{Binding SystemSettings}" />
				</TabItem>
			</TabControl>
		</TabItem>
		<!-- The campground lookup (beta.8, D28; campgrounds by FacilityID since D42): read-only, one tab per way to look. -->
		<TabItem Name="CampsitesTab" Header="{x:Static forms:CampgroundsWording.Heading}">
			<TabControl Name="CampsitesTabControl" Classes="nested">
				<TabItem Name="ByParkTab" Header="{x:Static forms:CampgroundsWording.ByPark}">
					<Grid Name="ByParkContent" DataContext="{Binding ReactiveViewModel}" RowDefinitions="Auto,*" RowSpacing="12" Margin="0,8,0,0">
						<!-- The filter card: as wide as the details' column (D106), and from the wide width up as wide as their columns up to the readable 400 + 16 + 960, at their left (D107). -->
						<views:ResponsiveColumns Classes="mixed" Margin="0,0,16,0">
							<Border Name="ParkFilters" Classes="card">
								<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
									<Label Classes="fieldLabel" Content="{x:Static forms:CampgroundsWording.ParkLabel}" Target="{Binding #ParkComboBox}" />
									<ComboBox Name="ParkComboBox" Grid.Row="1" Classes="filter"
									          ItemsSource="{Binding ParkList}" SelectedItem="{Binding SelectedPark}"
									          ItemTemplate="{StaticResource NameItemTemplate}"
									          PlaceholderText="{x:Static forms:CampgroundsWording.ParkPlaceholder}" AutomationProperties.Name="Park" />
									<Label Grid.Column="1" Classes="fieldLabel" Content="{x:Static forms:CampgroundsWording.CampgroundLabel}" Target="{Binding #ParkCampgroundComboBox}" />
									<ComboBox Name="ParkCampgroundComboBox" Grid.Row="1" Grid.Column="1" Classes="filter campground"
									          ItemsSource="{Binding CampgroundListByPark}" SelectedItem="{Binding SelectedCampgroundByPark}"
									          ItemTemplate="{StaticResource CampgroundItemTemplate}"
									          IsEnabled="{Binding SelectedPark, Converter={x:Static ObjectConverters.IsNotNull}}"
									          PlaceholderText="{x:Static forms:CampgroundsWording.CampgroundPlaceholder}" AutomationProperties.Name="Campground" />
								</Grid>
							</Border>
						</views:ResponsiveColumns>
						<views:CampgroundDetailsView Name="ByParkDetails" Grid.Row="1" DataContext="{Binding ParkCampgroundDetails}"
						                             EmptyHint="{x:Static forms:CampgroundsWording.ByParkHint}" />
					</Grid>
				</TabItem>
				<TabItem Name="ByCityTab" Header="{x:Static forms:CampgroundsWording.ByCity}">
					<Grid Name="ByCityContent" DataContext="{Binding ReactiveViewModel}" RowDefinitions="Auto,*" RowSpacing="12" Margin="0,8,0,0">
						<!-- The filter card: as wide as the details' column (D106), and from the wide width up as wide as their columns up to the readable 400 + 16 + 960, at their left (D107). -->
						<views:ResponsiveColumns Classes="mixed" Margin="0,0,16,0">
							<Border Name="CityFilters" Classes="card">
								<Grid ColumnDefinitions="*,*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
									<Label Classes="fieldLabel" Content="{x:Static forms:CampgroundsWording.StateLabel}" Target="{Binding #CityStateComboBox}" />
									<ComboBox Name="CityStateComboBox" Grid.Row="1" Classes="filter"
									          ItemsSource="{Binding StateList}" SelectedItem="{Binding SelectedState}"
									          ItemTemplate="{StaticResource NameItemTemplate}"
									          PlaceholderText="{x:Static forms:CampgroundsWording.StatePlaceholder}" AutomationProperties.Name="State" />
									<Label Grid.Column="1" Classes="fieldLabel" Content="{x:Static forms:CampgroundsWording.CityLabel}" Target="{Binding #CityComboBox}" />
									<ComboBox Name="CityComboBox" Grid.Row="1" Grid.Column="1" Classes="filter"
									          ItemsSource="{Binding CityList}" SelectedItem="{Binding SelectedCity}"
									          ItemTemplate="{StaticResource CityItemTemplate}"
									          IsEnabled="{Binding SelectedState, Converter={x:Static ObjectConverters.IsNotNull}}"
									          PlaceholderText="{x:Static forms:CampgroundsWording.CityPlaceholder}" AutomationProperties.Name="City" />
									<Label Grid.Column="2" Classes="fieldLabel" Content="{x:Static forms:CampgroundsWording.CampgroundLabel}" Target="{Binding #CityCampgroundComboBox}" />
									<ComboBox Name="CityCampgroundComboBox" Grid.Row="1" Grid.Column="2" Classes="filter campground"
									          ItemsSource="{Binding CampgroundList}" SelectedItem="{Binding SelectedCampground}"
									          ItemTemplate="{StaticResource CampgroundItemTemplate}"
									          IsEnabled="{Binding SelectedCity, Converter={x:Static ObjectConverters.IsNotNull}}"
									          PlaceholderText="{x:Static forms:CampgroundsWording.CampgroundPlaceholder}" AutomationProperties.Name="Campground" />
								</Grid>
							</Border>
						</views:ResponsiveColumns>
						<views:CampgroundDetailsView Name="ByCityDetails" Grid.Row="1" DataContext="{Binding CityCampgroundDetails}"
						                             EmptyHint="{x:Static forms:CampgroundsWording.ByCityHint}" />
					</Grid>
				</TabItem>
				<TabItem Name="ByStateTab" Header="{x:Static forms:CampgroundsWording.ByState}">
					<Grid Name="ByStateContent" DataContext="{Binding ReactiveViewModel}" RowDefinitions="Auto,*" RowSpacing="12" Margin="0,8,0,0">
						<!-- The filter card: as wide as the details' column (D106), and from the wide width up as wide as their columns up to the readable 400 + 16 + 960, at their left (D107). -->
						<views:ResponsiveColumns Classes="mixed" Margin="0,0,16,0">
							<Border Name="StateFilters" Classes="card">
								<Grid ColumnDefinitions="*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
									<Label Classes="fieldLabel" Content="{x:Static forms:CampgroundsWording.StateLabel}" Target="{Binding #StateComboBox}" />
									<ComboBox Name="StateComboBox" Grid.Row="1" Classes="filter"
									          ItemsSource="{Binding StateListByState}" SelectedItem="{Binding SelectedStateByState}"
									          ItemTemplate="{StaticResource NameItemTemplate}"
									          PlaceholderText="{x:Static forms:CampgroundsWording.StatePlaceholder}" AutomationProperties.Name="State" />
									<Label Grid.Column="1" Classes="fieldLabel" Content="{x:Static forms:CampgroundsWording.CampgroundLabel}" Target="{Binding #StateCampgroundComboBox}" />
									<ComboBox Name="StateCampgroundComboBox" Grid.Row="1" Grid.Column="1" Classes="filter campground"
									          ItemsSource="{Binding CampgroundListByState}" SelectedItem="{Binding SelectedCampgroundByState}"
									          ItemTemplate="{StaticResource CampgroundItemTemplate}"
									          IsEnabled="{Binding SelectedStateByState, Converter={x:Static ObjectConverters.IsNotNull}}"
									          PlaceholderText="{x:Static forms:CampgroundsWording.CampgroundPlaceholder}" AutomationProperties.Name="Campground" />
								</Grid>
							</Border>
						</views:ResponsiveColumns>
						<views:CampgroundDetailsView Name="ByStateDetails" Grid.Row="1" DataContext="{Binding StateCampgroundDetails}"
						                             EmptyHint="{x:Static forms:CampgroundsWording.ByStateHint}" />
					</Grid>
				</TabItem>
			</TabControl>
		</TabItem>
	</TabControl>
	<!--
	  v0.4.0's phase 4 (D115): the window's close while the monitoring is on asks first, in the window: Keep Campertron open (the
	  first and default choice; Escape) leaves everything as it was, Stop the monitoring and close stops it (bounded, off the UI
	  thread) and then closes; meanwhile the tabs can't be used and the question says that it is stopping. Never for the
	  automatic restart's or the operating system's end.
	-->
	<Border Name="CloseConfirmationScrim" Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}" IsVisible="{Binding IsConfirmingClose}">
		<Border Name="CloseConfirmation" Classes="card notice" MaxWidth="560" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
			<StackPanel Spacing="12">
				<TextBlock Name="CloseConfirmationHeading" Classes="sectionHeading" Margin="0" Text="{x:Static app:DesktopMonitoringWording.CloseHeading}"
				           AutomationProperties.HeadingLevel="1" />
				<TextBlock Name="CloseConfirmationText" Classes="body" Text="{x:Static app:DesktopMonitoringWording.CloseText}" />
				<TextBlock Name="CloseMonitoringState" Classes="body" FontWeight="SemiBold" Text="{Binding CloseStateText}" />
				<WrapPanel Name="CloseChoices" Orientation="Horizontal" IsVisible="{Binding !IsStoppingForClose}">
					<Button Name="KeepOpenButton" Classes="accent" Margin="0,0,8,4" Content="{x:Static app:DesktopMonitoringWording.KeepOpenLabel}" Command="{Binding KeepOpenCommand}"
					        AutomationProperties.HelpText="{x:Static app:DesktopMonitoringWording.KeepOpenHelp}" />
					<Button Name="StopAndCloseButton" Margin="0,0,8,4" Content="{x:Static app:DesktopMonitoringWording.StopAndCloseLabel}" Command="{Binding StopAndCloseCommand}"
					        AutomationProperties.HelpText="{x:Static app:DesktopMonitoringWording.StopAndCloseHelp}" />
				</WrapPanel>
				<StackPanel Name="CloseStopping" Spacing="6" IsVisible="{Binding IsStoppingForClose}">
					<ProgressBar Name="CloseStoppingProgress" IsIndeterminate="True" AutomationProperties.Name="{x:Static app:DesktopMonitoringWording.StoppingText}" />
					<TextBlock Name="CloseStoppingText" Classes="body" Focusable="True" Text="{x:Static app:DesktopMonitoringWording.StoppingText}" AutomationProperties.LiveSetting="Polite" />
				</StackPanel>
			</StackPanel>
		</Border>
	</Border>
	</Panel>
</Window>
