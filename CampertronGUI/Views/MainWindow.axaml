<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:Campertron.ViewModels"
		xmlns:views="using:Campertron.Views"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
        x:CompileBindings="True"
		x:DataType="vm:MainWindowViewModel"
        x:Class="Campertron.Views.MainWindow"
        Title="Campertron"
        Width="1024" Height="768" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.Resources>
		<!-- Long park and campground names are trimmed with an ellipsis instead of widening the selector. -->
		<DataTemplate x:Key="NameItemTemplate" x:DataType="x:String">
			<TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<!-- Shows an empty city as "(No city listed)"; the item (and the query) keep the stored value. -->
		<DataTemplate x:Key="CityItemTemplate" x:DataType="x:String">
			<TextBlock Text="{Binding Converter={x:Static views:DisplayConverters.City}}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
	</Window.Resources>

	<!--
	  Three lookup tabs. Each tab has its own filters, campground selection and details (beta.8): a filter card on
	  top, then the shared CampgroundDetailsView, in one left-aligned column whose width is capped for readability.
	  Every list and details property queries the database when read, so each is bound exactly once.
	-->
	<TabControl Name="MainTabControl" Margin="8,4,8,0">
		<TabItem Header="By Park">
			<Grid Name="ByParkContent" DataContext="{Binding ReactiveViewModel}" RowDefinitions="Auto,*" RowSpacing="12" Margin="0,8,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MaxWidth="{StaticResource ContentColumnMaxWidth}" />
				</Grid.ColumnDefinitions>
				<Border Classes="card" Margin="0,0,16,0">
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
						<Label Classes="fieldLabel" Content="_Park" Target="{Binding #ParkComboBox}" />
						<ComboBox Name="ParkComboBox" Grid.Row="1" Classes="filter"
						          ItemsSource="{Binding ParkList}" SelectedItem="{Binding SelectedPark}"
						          ItemTemplate="{StaticResource NameItemTemplate}"
						          PlaceholderText="Select a park" AutomationProperties.Name="Park" />
						<Label Grid.Column="1" Classes="fieldLabel" Content="_Campground" Target="{Binding #ParkCampgroundComboBox}" />
						<ComboBox Name="ParkCampgroundComboBox" Grid.Row="1" Grid.Column="1" Classes="filter"
						          ItemsSource="{Binding CampgroundListByPark}" SelectedItem="{Binding SelectedCampgroundByPark}"
						          ItemTemplate="{StaticResource NameItemTemplate}"
						          IsEnabled="{Binding SelectedPark, Converter={x:Static ObjectConverters.IsNotNull}}"
						          PlaceholderText="Select a campground" AutomationProperties.Name="Campground" />
					</Grid>
				</Border>
				<views:CampgroundDetailsView Name="ByParkDetails" Grid.Row="1" DataContext="{Binding ParkCampgroundDetails}"
				                             EmptyHint="Choose a park, then one of its campgrounds, to see the campground ID and details." />
			</Grid>
		</TabItem>
		<TabItem Header="By City">
			<Grid Name="ByCityContent" DataContext="{Binding ReactiveViewModel}" RowDefinitions="Auto,*" RowSpacing="12" Margin="0,8,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MaxWidth="{StaticResource ContentColumnMaxWidth}" />
				</Grid.ColumnDefinitions>
				<Border Classes="card" Margin="0,0,16,0">
					<Grid ColumnDefinitions="*,*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
						<Label Classes="fieldLabel" Content="_State" Target="{Binding #CityStateComboBox}" />
						<ComboBox Name="CityStateComboBox" Grid.Row="1" Classes="filter"
						          ItemsSource="{Binding StateList}" SelectedItem="{Binding SelectedState}"
						          ItemTemplate="{StaticResource NameItemTemplate}"
						          PlaceholderText="Select a state" AutomationProperties.Name="State" />
						<Label Grid.Column="1" Classes="fieldLabel" Content="C_ity" Target="{Binding #CityComboBox}" />
						<ComboBox Name="CityComboBox" Grid.Row="1" Grid.Column="1" Classes="filter"
						          ItemsSource="{Binding CityList}" SelectedItem="{Binding SelectedCity}"
						          ItemTemplate="{StaticResource CityItemTemplate}"
						          IsEnabled="{Binding SelectedState, Converter={x:Static ObjectConverters.IsNotNull}}"
						          PlaceholderText="Select a city" AutomationProperties.Name="City" />
						<Label Grid.Column="2" Classes="fieldLabel" Content="_Campground" Target="{Binding #CityCampgroundComboBox}" />
						<ComboBox Name="CityCampgroundComboBox" Grid.Row="1" Grid.Column="2" Classes="filter"
						          ItemsSource="{Binding CampgroundList}" SelectedItem="{Binding SelectedCampground}"
						          ItemTemplate="{StaticResource NameItemTemplate}"
						          IsEnabled="{Binding SelectedCity, Converter={x:Static ObjectConverters.IsNotNull}}"
						          PlaceholderText="Select a campground" AutomationProperties.Name="Campground" />
					</Grid>
				</Border>
				<views:CampgroundDetailsView Name="ByCityDetails" Grid.Row="1" DataContext="{Binding CityCampgroundDetails}"
				                             EmptyHint="Choose a state, a city and then a campground to see the campground ID and details." />
			</Grid>
		</TabItem>
		<TabItem Header="By State">
			<Grid Name="ByStateContent" DataContext="{Binding ReactiveViewModel}" RowDefinitions="Auto,*" RowSpacing="12" Margin="0,8,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" MaxWidth="{StaticResource ContentColumnMaxWidth}" />
				</Grid.ColumnDefinitions>
				<Border Classes="card" Margin="0,0,16,0">
					<Grid ColumnDefinitions="*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
						<Label Classes="fieldLabel" Content="_State" Target="{Binding #StateComboBox}" />
						<ComboBox Name="StateComboBox" Grid.Row="1" Classes="filter"
						          ItemsSource="{Binding StateListByState}" SelectedItem="{Binding SelectedStateByState}"
						          ItemTemplate="{StaticResource NameItemTemplate}"
						          PlaceholderText="Select a state" AutomationProperties.Name="State" />
						<Label Grid.Column="1" Classes="fieldLabel" Content="_Campground" Target="{Binding #StateCampgroundComboBox}" />
						<ComboBox Name="StateCampgroundComboBox" Grid.Row="1" Grid.Column="1" Classes="filter"
						          ItemsSource="{Binding CampgroundListByState}" SelectedItem="{Binding SelectedCampgroundByState}"
						          ItemTemplate="{StaticResource NameItemTemplate}"
						          IsEnabled="{Binding SelectedStateByState, Converter={x:Static ObjectConverters.IsNotNull}}"
						          PlaceholderText="Select a campground" AutomationProperties.Name="Campground" />
					</Grid>
				</Border>
				<views:CampgroundDetailsView Name="ByStateDetails" Grid.Row="1" DataContext="{Binding StateCampgroundDetails}"
				                             EmptyHint="Choose a state, then one of its campgrounds, to see the campground ID and details." />
			</Grid>
		</TabItem>
	</TabControl>
</Window>
