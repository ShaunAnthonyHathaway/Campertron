<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Campertron.ViewModels"
             xmlns:forms="clr-namespace:CampertronLibrary.function.Forms;assembly=CampertronLibrary"
             xmlns:views="using:Campertron.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:CompileBindings="True"
             x:DataType="forms:CampgroundDetails"
             x:Class="Campertron.Views.CampgroundDetailsView"
             x:Name="Root">
	<!--
	  Details of the campground selected on one tab (shared by all three tabs). DataContext is a CampgroundDetails
	  snapshot; the lookup, not the data layer, owns every label and the "Not listed" text (since D99 the shared form
	  layer's CampgroundsWording, which the web UI's campgrounds pages show too). A text block's accessible name
	  is always its own text in Avalonia 12 (TextBlockAutomationPeer ignores Name and LabeledBy), so values follow
	  their visible labels in reading order; the focusable ID also carries its label as HelpText.
	-->
	<Panel>
		<!-- Before a campground is selected: as wide as the filter card above it (D106, D107). -->
		<views:ResponsiveColumns Classes="mixed" VerticalAlignment="Top" Margin="0,0,16,0">
			<Border Name="EmptyState" Classes="card" IsVisible="{Binding !HasCampground}">
				<StackPanel Spacing="4">
					<TextBlock Classes="sectionHeading" Text="{x:Static forms:CampgroundsWording.NoCampgroundSelected}" AutomationProperties.HeadingLevel="2" />
					<TextBlock Name="EmptyHintText" Classes="secondary body" Text="{Binding #Root.EmptyHint}" />
				</StackPanel>
			</Border>
		</views:ResponsiveColumns>

		<!--
		  One scrolling area for everything; focusable so the keyboard can scroll it. It spans the whole tab (R8), so the
		  mouse wheel works anywhere below the filters and the scroll bar is at the window edge; the transparent background
		  makes the area beside the columns hit-testable. The viewer starts 4 DIP up and left of the columns and the columns
		  are inset by 4 DIP, so its focus rectangle never touches the content while the content stays aligned with the filter
		  card. The responsive layout (D106): below the wide width one centered column (the name, the ID, the contact, then
		  the description, the directions and the fees, as before); from it up the name, the ID and the contact on the left and
		  the long texts beside them, in the same reading order. A mixed page (D107): the long texts' column grows up to two
		  readable columns, the description then beside the directions and the fees, and running text keeps a readable
		  line length.
		-->
		<ScrollViewer Name="DetailsScrollViewer" IsVisible="{Binding HasCampground}" Background="Transparent" Margin="-4,-4,0,0"
		              Focusable="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
		              AutomationProperties.Name="{x:Static forms:CampgroundsWording.DetailsName}">
			<views:ResponsiveColumns Name="DetailsLayout" Classes="mixed" Margin="4,4,16,8">
				<StackPanel Name="DetailsColumn" Spacing="12">
					<StackPanel Spacing="2">
						<TextBlock Name="CampgroundNameText" Classes="title" Text="{Binding Name}" AutomationProperties.HeadingLevel="1" />
						<TextBlock Name="CampgroundContextText" Classes="secondary" TextWrapping="Wrap"
						           Text="{Binding Context}" IsVisible="{Binding HasContext}" />
					</StackPanel>

					<Border Classes="card">
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="16">
							<TextBlock Name="CampgroundIdLabel" Classes="fieldLabel" Text="{x:Static forms:CampgroundsWording.CampgroundIdLabel}" />
							<!-- Sized to the number, with a 4-DIP inset for its focus rectangle; the negative margin keeps the
							     digits aligned with the label. -->
							<SelectableTextBlock Name="CampgroundIdText" Grid.Row="1" Classes="campgroundId"
							                     HorizontalAlignment="Left" Padding="4,2" Margin="-4,-2,0,-2"
							                     Text="{Binding CampgroundId}"
							                     AutomationProperties.HelpText="{x:Static forms:CampgroundsWording.CampgroundIdLabel}" />
							<Button Name="CopyIdButton" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center"
							        Content="Copy ID" Click="CopyIdButton_Click"
							        ToolTip.Tip="Copy the campground ID to the clipboard" />
							<TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap"
							           Text="{x:Static forms:CampgroundsWording.CampgroundIdNote}" />
							<TextBlock Name="CopyStatusText" Grid.Row="3" Grid.ColumnSpan="2" Classes="secondary" TextWrapping="Wrap"
							           Margin="0,4,0,0" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
						</Grid>
					</Border>

					<Border Classes="card">
						<StackPanel>
							<TextBlock Classes="sectionHeading" Text="{x:Static forms:CampgroundsWording.ContactHeading}" AutomationProperties.HeadingLevel="2" />
							<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
								<TextBlock Name="PhoneLabel" Classes="fieldLabel" Text="{x:Static forms:CampgroundsWording.PhoneLabel}" />
								<SelectableTextBlock Name="PhoneText" Grid.Column="1" Classes="body" IsTabStop="False"
								                     Text="{Binding Phone}" />
								<TextBlock Name="EmailLabel" Grid.Row="1" Classes="fieldLabel" Text="{x:Static forms:CampgroundsWording.EmailLabel}" />
								<SelectableTextBlock Name="EmailText" Grid.Row="1" Grid.Column="1" Classes="body" IsTabStop="False"
								                     Text="{Binding Email}" />
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Name="DetailsMainColumn" Spacing="12">
					<views:ResponsiveColumns Name="DetailsTexts" Classes="pair">
						<Border Classes="card">
							<StackPanel>
								<TextBlock Name="DescriptionHeading" Classes="sectionHeading" Text="{x:Static forms:CampgroundsWording.DescriptionHeading}" AutomationProperties.HeadingLevel="2" />
								<SelectableTextBlock Name="DescriptionText" Classes="body" IsTabStop="False" Text="{Binding Description}" />
							</StackPanel>
						</Border>

						<StackPanel Name="DetailsMoreTexts" Spacing="12">
							<Border Classes="card">
								<StackPanel>
									<TextBlock Name="DirectionsHeading" Classes="sectionHeading" Text="{x:Static forms:CampgroundsWording.DirectionsHeading}" AutomationProperties.HeadingLevel="2" />
									<SelectableTextBlock Name="DirectionsText" Classes="body" IsTabStop="False" Text="{Binding Directions}" />
								</StackPanel>
							</Border>

							<Border Classes="card">
								<StackPanel>
									<TextBlock Name="FeesHeading" Classes="sectionHeading" Text="{x:Static forms:CampgroundsWording.FeesHeading}" AutomationProperties.HeadingLevel="2" />
									<SelectableTextBlock Name="FeesText" Classes="body" IsTabStop="False" Text="{Binding Fees}" />
								</StackPanel>
							</Border>
						</StackPanel>
					</views:ResponsiveColumns>
				</StackPanel>
			</views:ResponsiveColumns>
		</ScrollViewer>
	</Panel>
</UserControl>
