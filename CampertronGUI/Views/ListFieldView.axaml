<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Campertron.ViewModels"
             xmlns:forms="clr-namespace:CampertronLibrary.function.Forms;assembly=CampertronLibrary"
             xmlns:views="using:Campertron.Views"
             x:CompileBindings="True"
             x:DataType="forms:ListSettingField"
             x:Class="Campertron.Views.ListFieldView">
	<!--
	  A list setting of a search file (CM6, decision D44): its label, whether it is changed, one row per item (the text, Up,
	  Down and Remove, and the validation's message about that item), Add, the list's own message and what it does. An item
	  that is empty in the file shows an empty box and stays as it is until the user types in it.
	-->
	<StackPanel Spacing="4">
		<StackPanel Orientation="Horizontal" Spacing="8">
			<Label Classes="fieldLabel" Content="{Binding Label}" Target="{Binding #AddButton}" />
			<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding IsChanged}" />
		</StackPanel>
		<TextBlock Name="RowsHelp" Classes="secondary body" Text="{Binding RowsHelp}" />
		<ItemsControl Name="Rows" ItemsSource="{Binding Rows}" IsEnabled="{Binding IsEditable}"
		              AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding HelpText}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel Spacing="8" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="forms:ListRow">
					<StackPanel Spacing="2">
						<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
							<TextBox Name="RowBox" Text="{Binding Text}" PlaceholderText="{Binding Placeholder}"
							         AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding HelpText}" />
							<Button Name="RowUpButton" Grid.Column="1" Content="Up" Command="{Binding UpCommand}" AutomationProperties.Name="{Binding UpName}" />
							<Button Name="RowDownButton" Grid.Column="2" Content="Down" Command="{Binding DownCommand}" AutomationProperties.Name="{Binding DownName}" />
							<Button Name="RowRemoveButton" Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding RemoveName}" />
						</Grid>
						<views:SeverityBlock IsError="{Binding IsError}">
							<TextBlock Classes="body" Text="{Binding MessageText}" IsVisible="{Binding HasMessage}" />
						</views:SeverityBlock>
					</StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<TextBlock Classes="secondary body" Text="{Binding EmptyText}" IsVisible="{Binding HasNoRows}" />
		<Button Name="AddButton" Content="{Binding AddLabel}" Command="{Binding AddCommand}" HorizontalAlignment="Left"
		        AutomationProperties.Name="{Binding AddLabel}" AutomationProperties.HelpText="{Binding AddHelpText}" />
		<views:SeverityBlock IsError="{Binding IsError}">
			<TextBlock Classes="body" Text="{Binding MessageText}" IsVisible="{Binding HasMessage}" />
		</views:SeverityBlock>
		<TextBlock Classes="secondary body" Text="{Binding LockReason}" IsVisible="{Binding HasLockReason}" />
		<TextBlock Classes="secondary body" Text="{Binding Hint}" />
	</StackPanel>
</UserControl>
