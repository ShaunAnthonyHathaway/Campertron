<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Campertron.ViewModels"
             xmlns:views="using:Campertron.Views"
             x:CompileBindings="True"
             x:DataType="vm:GeneralSettingsViewModel"
             x:Class="Campertron.Views.GeneralSettingsView">
	<!--
	  General.yaml (CM5, decision D43). Each setting: its label (with an access key), whether it is changed, the control,
	  the validation's message for it (its severity in words; also the control's accessible help text) and what it does.
	  Editing writes values only: nothing refreshes, downloads or searches.
	-->
	<StackPanel Spacing="12">
		<StackPanel Spacing="2">
			<TextBlock Classes="title" Text="{Binding Title}" AutomationProperties.HeadingLevel="1" />
			<SelectableTextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding FilePath}" IsTabStop="False" />
		</StackPanel>
		<views:SettingsFileStatusView Name="GeneralStatus" />
		<Border Name="GeneralForm" Classes="card" IsVisible="{Binding !IsMissing}">
			<StackPanel Spacing="16">
				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Label Classes="fieldLabel" Content="{Binding OutputTo.Label}" Target="{Binding #OutputToComboBox}" />
						<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding OutputTo.IsChanged}" />
					</StackPanel>
					<ComboBox Name="OutputToComboBox" HorizontalAlignment="Stretch" ItemsSource="{Binding OutputTo.Choices}" SelectedItem="{Binding OutputTo.Selected}"
					          IsEnabled="{Binding OutputTo.IsEditable}" AutomationProperties.Name="{Binding OutputTo.AccessibleName}"
					          AutomationProperties.HelpText="{Binding OutputTo.HelpText}" />
					<TextBlock Classes="body" Classes.error="{Binding OutputTo.IsError}" Text="{Binding OutputTo.MessageText}" IsVisible="{Binding OutputTo.HasMessage}" />
					<TextBlock Classes="secondary body" Text="{Binding OutputTo.LockReason}" IsVisible="{Binding OutputTo.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding OutputTo.Hint}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<CheckBox Name="AutoRefreshCheckBox" Content="{Binding AutoRefresh.Label}" IsChecked="{Binding AutoRefresh.IsChecked}"
						          IsEnabled="{Binding AutoRefresh.IsEditable}" AutomationProperties.Name="{Binding AutoRefresh.AccessibleName}"
						          AutomationProperties.HelpText="{Binding AutoRefresh.HelpText}" />
						<TextBlock Classes="secondary" VerticalAlignment="Center" Text="Changed" IsVisible="{Binding AutoRefresh.IsChanged}" />
					</StackPanel>
					<TextBlock Classes="body" Classes.error="{Binding AutoRefresh.IsError}" Text="{Binding AutoRefresh.MessageText}" IsVisible="{Binding AutoRefresh.HasMessage}" />
					<TextBlock Classes="secondary body" Text="{Binding AutoRefresh.LockReason}" IsVisible="{Binding AutoRefresh.HasLockReason}" />
					<TextBlock Name="RefreshExplanation" Classes="secondary body" Text="{Binding RefreshExplanation}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Label Classes="fieldLabel" Content="{Binding RefreshInterval.Label}" Target="{Binding #RefreshIntervalBox}" />
						<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding RefreshInterval.IsChanged}" />
					</StackPanel>
					<TextBox Name="RefreshIntervalBox" Text="{Binding RefreshInterval.Text}" IsEnabled="{Binding RefreshInterval.IsEditable}"
					         AutomationProperties.Name="{Binding RefreshInterval.AccessibleName}" AutomationProperties.HelpText="{Binding RefreshInterval.HelpText}" />
					<TextBlock Classes="body" Classes.error="{Binding RefreshInterval.IsError}" Text="{Binding RefreshInterval.MessageText}" IsVisible="{Binding RefreshInterval.HasMessage}" />
					<TextBlock Classes="secondary body" Text="{Binding RefreshInterval.LockReason}" IsVisible="{Binding RefreshInterval.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding RefreshInterval.Hint}" />
				</StackPanel>

				<StackPanel Spacing="4">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Label Classes="fieldLabel" Content="{Binding LastRefresh.Label}" Target="{Binding #LastRefreshBox}" />
						<TextBlock Classes="secondary" Text="Changed" IsVisible="{Binding LastRefresh.IsChanged}" />
					</StackPanel>
					<TextBox Name="LastRefreshBox" Text="{Binding LastRefresh.Text}" IsEnabled="{Binding LastRefresh.IsEditable}"
					         AutomationProperties.Name="{Binding LastRefresh.AccessibleName}" AutomationProperties.HelpText="{Binding LastRefresh.HelpText}" />
					<TextBlock Classes="body" Classes.error="{Binding LastRefresh.IsError}" Text="{Binding LastRefresh.MessageText}" IsVisible="{Binding LastRefresh.HasMessage}" />
					<TextBlock Classes="secondary body" Text="{Binding LastRefresh.LockReason}" IsVisible="{Binding LastRefresh.HasLockReason}" />
					<TextBlock Classes="secondary body" Text="{Binding LastRefresh.Hint}" />
				</StackPanel>
			</StackPanel>
		</Border>
		<views:SettingsFileActionsView Name="GeneralActions" />
	</StackPanel>
</UserControl>
