<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="using:Campertron"
             x:Class="Campertron.App"
			 RequestedThemeVariant="Default">
	<!-- Default follows the operating system's Light or Dark theme. -->
	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://CampertronGUI/Styles/AppStyles.axaml"/>
    </Application.Styles>
</Application>
